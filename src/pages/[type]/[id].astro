---
import EntityPage from "../../components/EntityPage.jsx";

const type = Astro.params.type;
const id = Astro.params.id;
if (!type || !id || !["song", "artist", "album"].includes(type)) {
  return Astro.redirect("/");
}
const token = Astro.url.searchParams.get("token");
const suffix = token ? `?token=${encodeURIComponent(token)}` : "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Playstats | Archive details</title>
  </head>
  <body>
    <EntityPage
      client:load
      type={type}
      dataEndpoint={`/data/entity/${type}/${encodeURIComponent(id)}${suffix}`}
      homeHref={`/${suffix}`}
      statsHref={`/all${suffix}`}
    />
  </body>
</html>

<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=Manrope:wght@400;500;600;700;800&display=swap");
  :root { color-scheme: dark; font-family: "Manrope", sans-serif; background: #080908; color: #f4f1e8; }
  * { box-sizing: border-box; }
  html, body { min-width: 320px; min-height: 100%; margin: 0; background: #080908; }
</style>
