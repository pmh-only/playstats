---
import PlayStatsDashboard from "../components/PlayStatsDashboard.jsx";
import { getPlayStats, type PlayStats } from "../lib/stats";

const token = Astro.url.searchParams.get("token");
const homeHref = token ? `/?token=${encodeURIComponent(token)}` : "/";
const statsHref = token ? `/all?token=${encodeURIComponent(token)}` : "/all";
let stats: PlayStats | null = null;
let error = "";

try {
  stats = await getPlayStats(token ?? undefined);
  if (!stats) {
    error = token
      ? "No listening history was found for this token."
      : "A public listening token is required for multi-user libraries.";
  }
} catch (cause) {
  console.error("Failed to load listening statistics", cause);
  error = "Listening statistics are temporarily unavailable.";
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Explore your Spotify listening activity across today, this week, month, year, and all time."
    />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='14' fill='%23b8ff57'/%3E%3C/svg%3E"
    />
    <title>Playstats | Listening statistics</title>
  </head>
  <body>
    <PlayStatsDashboard
      client:load
      stats={stats}
      error={error}
      homeHref={homeHref}
      statsHref={statsHref}
    />
  </body>
</html>

<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=Manrope:wght@400;500;600;700;800&display=swap");

  :root {
    color-scheme: dark;
    font-family: "Manrope", sans-serif;
    background: #080908;
    color: #f4f1e8;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    min-width: 320px;
    min-height: 100%;
    margin: 0;
    background: #080908;
  }

  button,
  input {
    font: inherit;
  }
</style>
