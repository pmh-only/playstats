---
import ArchivePage from "../components/ArchivePage.jsx";

const token = Astro.url.searchParams.get("token");
const suffix = token ? `?token=${encodeURIComponent(token)}` : "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='14' fill='%23b8ff57'/%3E%3C/svg%3E" />
    <title>Playstats | Tops</title>
  </head>
  <body>
    <ArchivePage
      client:load
      type="tops"
      dataEndpoint={`/data/rankings${token ? `?token=${encodeURIComponent(token)}` : ""}`}
      homeHref={`/${suffix}`}
      statsHref={`/all${suffix}`}
    />
  </body>
</html>

<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=Manrope:wght@400;500;600;700;800&display=swap");
  :root { color-scheme: dark; font-family: "Manrope", sans-serif; background: #080908; color: #f4f1e8; }
  * { box-sizing: border-box; }
  html, body { min-width: 320px; min-height: 100%; margin: 0; background: #080908; }
  button { font: inherit; }
</style>
